.page{min-height:100vh;padding:40rpx 30rpx;color:#f7f0df}.header{text-align:center;padding:45rpx 0 55rpx}.symbol{display:block;font-size:75rpx;color:#eac36d}.title{display:block;font-size:42rpx;font-weight:800;margin-top:15rpx}.subtitle{display:block;font-size:24rpx;letter-spacing:10rpx;color:#eac36d;margin-top:15rpx}.card{border-radius:24rpx;background:#fff;color:#243147;padding:40rpx 35rpx;box-shadow:0 15rpx 50rpx #0003;font-size:28rpx}.error{color:#ba3444}.result{padding:14rpx 0 30rpx;border-bottom:2rpx solid #edf0f4;margin-bottom:20rpx}.result:last-child{border:0;margin-bottom:0}.prize{font-size:30rpx;font-weight:800;color:#9b6b0b;margin-bottom:20rpx}.winner{display:flex;align-items:center;gap:18rpx;padding:12rpx 0;font-size:29rpx}.medal{color:#d7aa4f}.refresh{margin-top:35rpx;border:2rpx solid #dbbd80;color:#f3d89c;background:#ffffff16;border-radius:13rpx}.refresh:after{border:0}
.logo{display:block;width:150rpx;height:70rpx;margin:0 auto 15rpx}
