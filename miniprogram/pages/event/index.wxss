.page{min-height:100vh;padding-bottom:40rpx}.hero{height:480rpx;position:relative;overflow:hidden;background:linear-gradient(135deg,#253d73,#0a1630)}.banner{width:100%;height:100%}.hero-art{height:100%;display:flex;align-items:center;justify-content:center;color:#edd08d;font-size:50rpx;letter-spacing:9rpx}.hero-art text{font-size:27rpx;margin:0 18rpx}.hero-content{position:absolute;left:44rpx;right:44rpx;bottom:90rpx;text-shadow:0 4rpx 20rpx #0009;display:flex;flex-direction:column;color:#fff}.kicker{font-size:24rpx;letter-spacing:8rpx;margin-bottom:14rpx}.hero-title{font-size:50rpx;font-weight:800;line-height:1.25}.hero-date{font-size:24rpx;margin-top:15rpx;color:#f3e9da}.content-card{position:relative;background:#fff;border-radius:32rpx 32rpx 24rpx 24rpx;margin:-40rpx 28rpx 0;padding:40rpx 38rpx;box-shadow:0 24rpx 60rpx #0002;color:#273044;min-height:280rpx}.section-title{font-size:37rpx;font-weight:800;margin-bottom:24rpx}.description{font-size:25rpx;line-height:1.6;color:#657185;margin-bottom:24rpx;white-space:pre-wrap}.field{margin:30rpx 0}.label{display:block;font-size:26rpx;font-weight:700;margin-bottom:13rpx}.required{color:#d8515d}.input{height:88rpx;background:#f6f8fb;border:2rpx solid #e7ebf1;border-radius:13rpx;padding:0 20rpx;font-size:27rpx}.agreement{display:flex;align-items:flex-start;gap:7rpx;font-size:22rpx;color:#7a8495;line-height:1.5;margin-top:40rpx}.agreement checkbox{transform:scale(.75);transform-origin:left top}.submit{color:#fff;border-radius:14rpx;font-weight:800;font-size:30rpx;margin:35rpx 0 16rpx}.submit:after,.results-link:after{border:0}.results-link{background:transparent;color:#315db2;font-size:25rpx}.registered{background:#e6f8ee;border-radius:14rpx;padding:24rpx;color:#188251;font-size:28rpx}.closed{background:#f5f7fa;border-radius:14rpx;padding:23rpx;color:#647188;line-height:1.6;font-size:25rpx}.error{color:#bc3340}.footer{text-align:center;color:#bdc9dd;font-size:21rpx;letter-spacing:4rpx;margin-top:44rpx}
.logo{display:block;width:135rpx;height:65rpx;margin-bottom:16rpx}
.hero-spring{background:linear-gradient(135deg,#72bb98,#153d37)}.hero-formal{background:linear-gradient(135deg,#5c7796,#172234)}
